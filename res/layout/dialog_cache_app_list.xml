<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/ll_cache_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0F1018"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btn_cache_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clean Phone - Your Phone"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cache_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 B Selected"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Instant Wipe Quick Action -->
        <TextView
            android:id="@+id/btn_instant_wipe"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="⚡ Fast Wipe"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/chip_select_all_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Segmented Tabs Bar -->
    <LinearLayout
        android:id="@+id/ll_segmented_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_cache_header"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:background="#0A0A0F">

        <TextView
            android:id="@+id/tab_all_apps"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚡ All Apps"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/tab_segmented_selected"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_user_apps"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="👤 User Apps"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:background="@drawable/tab_segmented_unselected"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_system_apps"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⚙️ System"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:background="@drawable/tab_segmented_unselected"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Search Input Bar -->
    <EditText
        android:id="@+id/et_cache_search"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_below="@id/ll_segmented_tabs"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/search_input_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="🔍 Search apps..."
        android:textColorHint="#475569"
        android:textColor="#F8FAFC"
        android:textSize="13sp"
        android:singleLine="true"
        android:imeOptions="actionDone" />

    <!-- App List -->
    <ListView
        android:id="@+id/lv_cache_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/et_cache_search"
        android:layout_above="@id/ll_bottom_bar"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/ll_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#0F1018"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:elevation="10dp">

        <!-- Select All / None Chip -->
        <TextView
            android:id="@+id/chip_toggle_select"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="☑ All"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/chip_select_all_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Clean Selected Button -->
        <Button
            android:id="@+id/btn_clean_selected"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🧹 Clean Selected Cache"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_clean_emerald" />
    </LinearLayout>

</RelativeLayout>
