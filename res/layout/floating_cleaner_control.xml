<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_floating_root"
    android:layout_width="wrap_content"
    android:layout_height="52dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/floating_shortcut_pill_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:elevation="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Drag Grip & Status Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⋮⋮"
        android:textColor="#55FFFFFF"
        android:textSize="14sp"
        android:layout_marginEnd="6dp" />

    <TextView
        android:id="@+id/tv_float_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧹"
        android:textSize="16sp"
        android:layout_marginEnd="8dp" />

    <!-- Progress Counter & Current App -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tv_float_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0(done)/0(total)"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_float_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="110dp"
            android:text="Initializing..."
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Inline Action Buttons (Pause & Stop) -->
    <Button
        android:id="@+id/btn_float_pause_resume"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="⏸"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="@drawable/btn_float_pause"
        android:layout_marginEnd="6dp" />

    <Button
        android:id="@+id/btn_float_stop"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="⏹"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="@drawable/btn_float_stop" />

</LinearLayout>
