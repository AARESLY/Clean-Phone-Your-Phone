<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_closing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:fitsSystemWindows="true">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/ll_closing_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_closing_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLOSING APPS"
            android:textColor="#F8FAFC"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/tv_closing_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Automated force-stop &amp; memory reclamation"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:background="#1A38BDF8"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Center Circular Gauge -->
    <RelativeLayout
        android:id="@+id/rl_closing_gauge_container"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerInParent="true">

        <ProgressBar
            android:id="@+id/pb_closing_circle"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/circular_ring_bg" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_closing_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#F8FAFC"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_closing_percent_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERCENT"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="-4dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- App Name & Progress info below center -->
    <LinearLayout
        android:id="@+id/ll_closing_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rl_closing_gauge_container"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="36dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tv_closing_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHUTTING DOWN"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:background="@drawable/pill_status_active"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <TextView
            android:id="@+id/tv_closing_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tv_closing_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 (done) / 0 (total)"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />

        <!-- Linear Progress bar -->
        <ProgressBar
            android:id="@+id/pb_closing_horizontal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="260dp"
            android:layout_height="4dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_custom"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Bottom Controls: Red Circular Stop Button & Minimize Pill Button -->
    <LinearLayout
        android:id="@+id/ll_closing_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="48dp">

        <Button
            android:id="@+id/btn_closing_stop"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/btn_stop_circle"
            android:text="⏹"
            android:textColor="#EF4444"
            android:textSize="20sp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btn_closing_minimize"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_picker"
            android:text="📱 Minimize to Floating Pill"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

</RelativeLayout>
