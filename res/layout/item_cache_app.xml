<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_cache_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/item_cache_card_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Checkbox -->
    <CheckBox
        android:id="@+id/cb_cache_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:buttonTint="#10B981" />

    <!-- App Icon -->
    <ImageView
        android:id="@+id/iv_cache_app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="6dp"
        android:contentDescription="App Icon" />

    <!-- App Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tv_cache_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chrome"
            android:textColor="?attr/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_cache_pkg_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="com.android.chrome"
            android:textColor="?attr/textMuted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- Cache Size Badge -->
    <TextView
        android:id="@+id/tv_cache_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/cache_badge_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="105.8 MB"
        android:textColor="#10B981"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
