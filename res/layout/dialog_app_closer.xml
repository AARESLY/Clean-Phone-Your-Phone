<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_card_bg"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ App Closer"
                android:textColor="?attr/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_closer_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select apps to force-stop &amp; free RAM"
                android:textColor="?attr/textSecondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_closer_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="?attr/textSecondary"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Filter Tabs: User Apps | System Apps | All Apps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_tab_user"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="👤 User Apps"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/tab_btn_selected"
            android:layout_marginEnd="5dp" />

        <Button
            android:id="@+id/btn_tab_system"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="⚙️ System"
            android:textColor="?attr/textSecondary"
            android:textSize="12sp"
            android:background="@drawable/tab_btn_unselected"
            android:layout_marginEnd="5dp" />

        <Button
            android:id="@+id/btn_tab_all"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="⚡ All Apps"
            android:textColor="?attr/textSecondary"
            android:textSize="12sp"
            android:background="@drawable/tab_btn_unselected" />
    </LinearLayout>

    <!-- Quick select row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 apps selected"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_select_all"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Select All"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_picker"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_deselect_all"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Deselect All"
            android:textColor="#EF4444"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/btn_picker"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <!-- App List -->
    <ListView
        android:id="@+id/lv_apps"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical"
        android:layout_marginBottom="14dp" />

    <!-- Action Button -->
    <Button
        android:id="@+id/btn_execute_close_apps"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🛑 Close Selected Apps"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/btn_primary" />

</LinearLayout>
